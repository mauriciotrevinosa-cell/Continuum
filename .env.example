# Continuum Phase 0 - example environment.
#
# Copy to .env and adjust. NEVER commit .env (it is gitignored).
# This file must contain no real secret values (acceptance test 110.13).

# ---------------------------------------------------------------------------
# Data roots (D-01)
# ---------------------------------------------------------------------------
# The eight roots live OUTSIDE this repository and outside any cloud-sync
# folder (OneDrive/Dropbox/Google Drive/iCloud) -- see FOUNDATION_APPROVAL
# OQ-2. Set CONTINUUM_DATA_HOME and the individual roots default beneath it,
# or configure each one explicitly.
#
# Windows example:
CONTINUUM_DATA_HOME=C:/ContinuumData
# POSIX example:
# CONTINUUM_DATA_HOME=/srv/continuum

# The Source Vault is READ-ONLY to Continuum. Point it at your own media.
# For the test suite a synthetic vault under fixtures/demo_vault is used
# instead; never point this at copyrighted fixtures used by tests.
# CONTINUUM_SOURCE_VAULT_ROOT=D:/SourceVault

# Individually configurable (all optional when CONTINUUM_DATA_HOME is set):
# CONTINUUM_LIBRARY_ROOT=C:/ContinuumData/library
# CONTINUUM_PROJECTS_ROOT=C:/ContinuumData/projects
# CONTINUUM_GENERATED_ROOT=C:/ContinuumData/generated
# CONTINUUM_JOBS_ROOT=C:/ContinuumData/jobs
# CONTINUUM_MODELS_ROOT=C:/ContinuumData/models
# CONTINUUM_CACHE_ROOT=C:/ContinuumData/cache
# CONTINUUM_CONFIG_ROOT=C:/ContinuumData/config

# ---------------------------------------------------------------------------
# Database (D-02) - the sole durable job store
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. The password below is a local development
# placeholder, not a secret; change it if you expose the container.
CONTINUUM_DATABASE_URL=postgresql+psycopg://continuum:continuum_local_dev@127.0.0.1:5433/continuum

# ---------------------------------------------------------------------------
# API (A-03) - loopback only in Phase 0
# ---------------------------------------------------------------------------
# Any non-loopback value is REJECTED by configuration validation, because
# Phase 0 has no authentication.
CONTINUUM_API_HOST=127.0.0.1
CONTINUUM_API_PORT=8000
CONTINUUM_WEB_ORIGIN=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
CONTINUUM_WORKER_RESOURCE_CLASSES=cpu
CONTINUUM_WORKER_LEASE_SECONDS=30
CONTINUUM_WORKER_HEARTBEAT_SECONDS=5
CONTINUUM_MAX_CONCURRENCY_CPU=4
CONTINUUM_MAX_CONCURRENCY_GPU=1

# ---------------------------------------------------------------------------
# Providers (D-12) - Phase 0 ships fakes only; no AI SDK, no cloud account
# ---------------------------------------------------------------------------
CONTINUUM_PRODUCTION_PROFILE=FREE_LOCAL

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
CONTINUUM_LOG_LEVEL=INFO
