# Continuum Phase 0 - example environment.
#
# Copy to .env and adjust. NEVER commit .env (it is gitignored).
# This file must contain no real secret values (acceptance test 110.13).

# ---------------------------------------------------------------------------
# Data roots (D-01)
# ---------------------------------------------------------------------------
# The eight roots live OUTSIDE this repository and outside any cloud-sync
# folder (OneDrive/Dropbox/Google Drive/iCloud) -- see FOUNDATION_APPROVAL
# OQ-2. Set CONTINUUM_DATA_HOME and the individual roots default beneath it,
# or configure each one explicitly.
#
# Windows example:
CONTINUUM_DATA_HOME=C:/ContinuumData
# POSIX example:
# CONTINUUM_DATA_HOME=/srv/continuum

# The Source Vault is READ-ONLY to Continuum. Point it at your own media.
# For the test suite a synthetic vault under fixtures/demo_vault is used
# instead; never point this at copyrighted fixtures used by tests.
# CONTINUUM_SOURCE_VAULT_ROOT=D:/SourceVault

# Individually configurable (all optional when CONTINUUM_DATA_HOME is set):
# CONTINUUM_LIBRARY_ROOT=C:/ContinuumData/library
# CONTINUUM_PROJECTS_ROOT=C:/ContinuumData/projects
# CONTINUUM_GENERATED_ROOT=C:/ContinuumData/generated
# CONTINUUM_JOBS_ROOT=C:/ContinuumData/jobs
# CONTINUUM_MODELS_ROOT=C:/ContinuumData/models
# CONTINUUM_CACHE_ROOT=C:/ContinuumData/cache
# CONTINUUM_CONFIG_ROOT=C:/ContinuumData/config

# ---------------------------------------------------------------------------
# Database (D-02) - the sole durable job store
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. The password below is a local development
# placeholder, not a secret; change it if you expose the container.
CONTINUUM_DATABASE_URL=postgresql+psycopg://continuum:continuum_local_dev@127.0.0.1:5433/continuum

# ---------------------------------------------------------------------------
# API (A-03) - loopback only in Phase 0
# ---------------------------------------------------------------------------
# Any non-loopback value is REJECTED by configuration validation, because
# Phase 0 has no authentication.
CONTINUUM_API_HOST=127.0.0.1
CONTINUUM_API_PORT=8000
CONTINUUM_WEB_ORIGIN=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
CONTINUUM_WORKER_RESOURCE_CLASSES=cpu
CONTINUUM_WORKER_LEASE_SECONDS=30
CONTINUUM_WORKER_HEARTBEAT_SECONDS=5
CONTINUUM_MAX_CONCURRENCY_CPU=4
CONTINUUM_MAX_CONCURRENCY_GPU=1

# ---------------------------------------------------------------------------
# Providers (D-12) - Phase 0 ships fakes only; no AI SDK, no cloud account
# ---------------------------------------------------------------------------
CONTINUUM_PRODUCTION_PROFILE=FREE_LOCAL

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
CONTINUUM_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Library acquisition (Library membership != Project membership)
# ---------------------------------------------------------------------------
# Where the acquisition engine writes its documents. Empty means
# "<library root>/acquisition". A directory that does not exist yet is a valid
# empty state: the screens render their empty state instead of failing.
# CONTINUUM_ACQUISITION_DATA_DIR=C:/ContinuumData/acquisition
# Full path of acquisition_orchestrator.py. Without it the API serves
# acquisition data read-only and every action answers with the command to run
# yourself. Only read-only verbs are ever invoked: --apply is not reachable
# from the UI, because the Source Vault is read-only to Continuum (ADR-0001).
# CONTINUUM_ACQUISITION_CLI=C:/ContinuumTools/acquisition/acquisition_orchestrator.py

# Projects (continuum.project.json manifests) are discovered in these sources,
# separated by ";". Empty means the projects root. A clean installation has no
# projects; nothing is assumed.
#
# A source is a folder, or a Git ref read at its current commit without a
# checkout:  git:<repository>@<ref>[:<directory>]
# Use a remote-tracking ref (origin/<branch>) when a branch is the project's
# source of truth: "Resync from Git" in the project fetches that ref and nothing
# else, and the studio shows exactly what is committed there.
# CONTINUUM_PROJECT_SOURCES=
# CONTINUUM_PROJECT_SOURCES=git:D:/Repos/my-studio@origin/story-branch:docs/story

# ---------------------------------------------------------------------------
# Full-Vault catalog (Phase 1.5)
# ---------------------------------------------------------------------------
# Read-only intake folders the catalog scans (and can import from) besides the
# Source Vault, as "Collection:material=path" pairs separated by ";". The
# material is optional (fan_art, reference, document, manga, anime). Continuum
# never writes, renames or deletes anything in these folders.
# CONTINUUM_INTAKE_ROOTS=FanArt:fan_art=D:/Intake/FanArt
# Videos inside compressed archives are extracted on demand, one at a time,
# into ContinuumData/cache/archive-members. Least recently used copies are
# evicted to stay within this budget (bytes). Never extracted into the Vault.
# CONTINUUM_MEMBER_CACHE_BYTES=21474836480
# CONTINUUM_MEMBER_CACHE_MAX_MEMBER_BYTES=8589934592

# ---------------------------------------------------------------------------
# Provider policy: two axes, not one (M3)
# ---------------------------------------------------------------------------
# Where work may run and what it may cost are separate decisions. A GPU
# session opened in a notebook is REMOTE and FREE; a cheap API is nobody's
# local machine and bills on every call. A production profile is a named pair
# of the two; either may be overridden on its own.
# CONTINUUM_PRODUCTION_PROFILE=FREE_LOCAL
# CONTINUUM_LOCALITY_POLICY=REMOTE_ALLOWED
# CONTINUUM_SPEND_POLICY=FREE_ONLY

# ---------------------------------------------------------------------------
# ComfyUI backends and model families (M3)
# ---------------------------------------------------------------------------
# A backend is registered only when its URL is set. COMFY_REMOTE receives only
# a page or panel's materialized reference bundle, never the Vault, and never
# a verbatim source excerpt unless explicitly allowed below.
# CONTINUUM_COMFY_LOCAL_URL=http://127.0.0.1:8188
# CONTINUUM_COMFY_REMOTE_URL=
# CONTINUUM_COMFY_CHECKPOINT=
# CONTINUUM_COMFY_CHECKPOINT_VERSION=
# CONTINUUM_COMFY_CHECKPOINT_SHA256=
# CONTINUUM_COMFY_CHECKPOINT_LICENSE=
# CONTINUUM_COMFY_CHECKPOINT_SOURCE=
# CONTINUUM_COMFY_REMOTE_ALLOW_SOURCE_EXCERPTS=false
#
# Which graph shape the checkpoint needs: UNIFIED_CHECKPOINT (one node loads
# weights, text encoder and VAE) or SEPARATE_ENCODERS (they load separately,
# with their own guidance and latent nodes). The vendor family names people
# type are accepted as aliases. Neither shape is the better one; the split
# graph has no IP-Adapter path here, so Continuum reports no reference
# conditioning for it rather than pretending.
# CONTINUUM_COMFY_MODEL_FAMILY=UNIFIED_CHECKPOINT
# CONTINUUM_COMFY_CLIP_NAMES=clip_l.safetensors;t5xxl_fp8_e4m3fn.safetensors
# CONTINUUM_COMFY_VAE_NAME=ae.safetensors
# CONTINUUM_COMFY_FLUX_GUIDANCE=3.5
#
# Adapters, recorded with every image they touched.
# CONTINUUM_COMFY_LORAS=[{"name":"house-style.safetensors","strength_model":0.7,"strength_clip":0.6,"version":"1","sha256":"","license":"","source":""}]

# ---------------------------------------------------------------------------
# Paid image generation (M3). Off unless every part is configured.
# ---------------------------------------------------------------------------
# Enabling the provider only registers it. The spend policy decides whether it
# may ever be selected, and the ledger decides whether one request fits.
# CONTINUUM_GOOGLE_IMAGES_ENABLED=false
# CONTINUUM_GOOGLE_API_KEY=
# CONTINUUM_GOOGLE_IMAGE_ENDPOINT=
# Model identifiers exactly as the vendor names them. Two tiers: a cheap one
# for exploration and comparison, a better one for the few artifacts
# everything else is built from. Names change; this is configuration.
# CONTINUUM_GOOGLE_IMAGE_MODEL_CHEAP=
# CONTINUUM_GOOGLE_IMAGE_MODEL_HIGH=
# CONTINUUM_GOOGLE_IMAGE_LICENSE=
# CONTINUUM_GOOGLE_IMAGE_SOURCE=

# The hard cap on paid generation. Not a warning: a request whose estimate
# does not fit under what is left is refused, and there is no overdraft.
# CONTINUUM_SPEND_CAP_USD=10.0
# CONTINUUM_SPEND_SCOPE=default
# Prices are configuration, in integer micro-dollars per image, optionally
# bracketed by pixels and with a separate batch price. An unpriced request
# cannot be paid for: an unknown cost is not zero.
# CONTINUUM_IMAGE_PRICE_LIST=[{"provider_id":"google.image","model_ref":"<model>","per_image_micros":39000,"up_to_pixels":1048576,"batch_per_image_micros":19500}]
