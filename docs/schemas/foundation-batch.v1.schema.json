{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.local/schemas/foundation-batch.v1.schema.json",
  "title": "Foundation batch",
  "description": "The reusable visual anchors a season is built on, as an editable manifest. Priced and checked before anything is reserved; never started automatically.",
  "type": "object",
  "required": ["schema", "project_key", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "continuum.foundation-batch/1" },
    "project_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "label": { "type": "string", "maxLength": 200 },
    "defaults": {
      "type": "object",
      "description": "Applied to any item that does not override them.",
      "properties": {
        "provider_id": { "type": "string" },
        "model_ref": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "batch": { "type": "boolean" },
        "tier": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": {
            "enum": [
              "CHARACTER_SHEET",
              "OUTFIT_SHEET",
              "PROP_SCALE_SHEET",
              "CALIBRATION_RERUN",
              "INTERACTION",
              "ENSEMBLE",
              "LANGUAGE_STRESS_TEST"
            ],
            "description": "Every kind is a reusable anchor. A finished manga page is not one."
          },
          "count": { "type": "integer", "minimum": 1, "maximum": 100 },
          "subject": {
            "type": "string",
            "description": "What the item is about, in the project's own words."
          },
          "character": { "type": "string" },
          "sheet_kind": {
            "enum": ["HEAD", "FULL_BODY", "MANGA_TRANSLATION", "OUTFIT", "ACCESSORY_SCALE"]
          },
          "variant": {
            "type": "string",
            "description": "Which outfit or prop an OUTFIT / ACCESSORY_SCALE sheet is about."
          },
          "cal_id": { "type": "string" },
          "provider_id": { "type": "string" },
          "model_ref": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "batch": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
