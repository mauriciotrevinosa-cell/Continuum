{
  "name": "continuum",
  "private": true,
  "version": "0.0.0",
  "description": "Project Continuum - Phase 0 foundation (Node workspace)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @continuum/web dev",
    "build:web": "pnpm --filter @continuum/web build",
    "typecheck": "pnpm --filter @continuum/web typecheck",
    "lint": "pnpm --filter @continuum/web lint",
    "test": "pnpm --filter @continuum/web test",
    "api:client": "uv run python scripts/export_openapi.py && pnpm --filter @continuum/web api:client"
  }
}
